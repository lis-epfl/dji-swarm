<?xml version="1.0" encoding="utf-8"?>
<!-- The operator's screen: one status line, the sticks and dials, and alerts only when
     something needs doing. Everything diagnostic lives behind Details. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp">

        <!-- Header: state, why, and where the stream goes. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp" />

            <TextView
                android:id="@+id/status_word"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:textColor="@color/text"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/status_detail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chip_net"
                style="@style/Chip" />

            <TextView
                android:id="@+id/chip_pc"
                style="@style/Chip"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/chip_batt"
                style="@style/Chip"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Alerts: empty (gone) in normal operation. -->
        <LinearLayout
            android:id="@+id/alerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Instruments: left stick and dial, the source readout, right stick and dial. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.liscontroller.StickPadView
                    android:id="@+id/pad_left"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.liscontroller.DialBarView
                    android:id="@+id/dial_left"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="28dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="190dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/src_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.18"
                    android:textColor="@color/text_faint"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/src_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:textColor="@color/text"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/src_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/buttons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.liscontroller.StickPadView
                    android:id="@+id/pad_right"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.liscontroller.DialBarView
                    android:id="@+id/dial_right"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="28dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_details"
                style="@style/Pill"
                android:text="@string/open_details" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btn_grant"
                style="@style/Pill"
                android:background="@drawable/btn_primary"
                android:text="@string/grant"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_retry"
                style="@style/Pill"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_primary"
                android:text="@string/retry_sdk"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btn_stop"
                style="@style/Pill"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_danger"
                android:text="@string/stop_exit"
                android:textColor="@color/bad" />
        </LinearLayout>
    </LinearLayout>

    <!-- Details: every diagnostic the bench and DEBUGGING.md use, over the main screen.
         Opens by itself in safe mode, where it also carries the stage buttons. -->
    <LinearLayout
        android:id="@+id/details"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F80B0E13"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/details_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_close"
                style="@style/Pill"
                android:text="@string/close" />
        </LinearLayout>

        <!-- Safe mode only: start the service one stage at a time to find the one that
             crashes (DEBUGGING.md). -->
        <LinearLayout
            android:id="@+id/safe_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btn_stage1"
                style="@style/Pill"
                android:text="@string/stage1" />

            <TextView
                android:id="@+id/btn_stage2"
                style="@style/Pill"
                android:layout_marginStart="8dp"
                android:text="@string/stage2" />

            <TextView
                android:id="@+id/btn_stage3"
                style="@style/Pill"
                android:layout_marginStart="8dp"
                android:text="@string/stage3" />

            <TextView
                android:id="@+id/btn_clear"
                style="@style/Pill"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_primary"
                android:text="@string/clear_start" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/chip_bg"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/diag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="1dp"
                android:padding="12dp"
                android:textColor="@color/text_dim"
                android:textIsSelectable="false"
                android:textSize="10.5sp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
